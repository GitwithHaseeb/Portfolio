* text eol=lf

# Files that are truly binary and must never be line-ending converted.
# Anything not listed here is treated as text by the rule above, which
# strips CR bytes and silently corrupts binary content.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.avif binary
*.pdf binary
*.mp4 binary
*.webm binary
*.zip binary
